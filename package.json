{
  "name": "metallic-colors",
  "version": "0.5.0",
  "description": "Metallic paint swatches in CSS or Sass: layered gradients calibrated from photographed readings of the real surface.",
  "license": "MIT",
  "author": "Steve Hoang (https://stevehoang.com)",
  "homepage": "https://github.com/lotusk08/metallic-colors#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lotusk08/metallic-colors.git"
  },
  "bugs": {
    "url": "https://github.com/lotusk08/metallic-colors/issues"
  },
  "keywords": [
    "metallic",
    "metal",
    "swatch",
    "color",
    "colour",
    "paint",
    "css",
    "gradient",
    "oklab",
    "react",
    "scss",
    "sass",
    "mixin",
    "swatches",
    "palette"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./metallic.css": "./metallic.css",
    "./scss": {
      "sass": "./scss/_index.scss",
      "default": "./scss/_index.scss"
    },
    "./scss/metallic": {
      "sass": "./scss/metallic.scss",
      "default": "./scss/metallic.scss"
    },
    "./scss/*": "./scss/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "metallic.css",
    "scss",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "demo": "npm run build && npx --yes serve -l 4173 .",
    "build:css": "sass --no-source-map scss/metallic.scss metallic.css",
    "build:site": "node scripts/build-site.mjs",
    "build:textures": "node scripts/build-textures.mjs"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "sass": "^1.104.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
